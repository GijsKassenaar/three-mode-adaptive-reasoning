#!/bin/bash
# Evaluate a HuggingFace model with NO routing question, under the paper's
# benchmark protocol (same as scripts/eval_benchmarks_baseline.job):
#   - AIME 2024 + AIME 2025  @ n=16
#   - MATH-500               @ n=5
#   - GSM8K                  @ n=5
#   temperature 0.6, top_p 1.0, max response 16384, boxed MATH scorer
#
# Use this for:
#   - untrained bases (default: DeepSeek-R1-Distill-Qwen-1.5B)
#   - released AdaptThink HF checkpoints (Think / NoThink is already in the policy)
#
# Routing stays OFF: AdaptThink does not emit NOTHINK/SHORT/LONG. Injecting our
# routing question would not be a fair comparison.
#
# Examples:
#   sbatch scripts/eval_hf_no_routing.job
#   MODEL=THU-KEG/AdaptThink-1.5B-delta0.05 TAG=adaptthink_1p5b_d005 \
#     sbatch scripts/eval_hf_no_routing.job
#   MODEL=THU-KEG/AdaptThink-7B-delta0.05 TAG=adaptthink_7b_d005 \
#     ROLLOUT_TP_SIZE=2 GPU_MEM_UTIL=0.4 sbatch scripts/eval_hf_no_routing.job
#   MODEL=SONGJUNTU/Distill-R1-1.5B-AutoThink-Stage3 TAG=autothink_1p5b_s3 \
#     sbatch scripts/eval_hf_no_routing.job
#   MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B TAG=base_7b \
#     ROLLOUT_TP_SIZE=2 GPU_MEM_UTIL=0.4 sbatch scripts/eval_hf_no_routing.job

#SBATCH --job-name=eval_hf_no_routing
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=64
#SBATCH --mem=600G
#SBATCH --time=04:00:00

module purge
module load 2025
module load CUDA/12.8.0

source ~/.bashrc
eval "$(conda shell.bash hook 2>/dev/null)" || true
conda activate zero

set -uo pipefail

unset ROCR_VISIBLE_DEVICES
unset HIP_VISIBLE_DEVICES

export HF_HOME=/scratch-shared/$USER/huggingface
mkdir -p "$HF_HOME"
export WANDB__SERVICE_WAIT=300
export WANDB_DIR=/scratch-shared/$USER/wandb
mkdir -p "$WANDB_DIR"

cd "${REPO_DIR:-$HOME/three-mode-routing}"
# shellcheck source=scripts/paper_protocol.sh
source "${REPO_DIR:-$PWD}/scripts/paper_protocol.sh"
paper_require_python

export N_GPUS=${N_GPUS:-4}
export ROLLOUT_TP_SIZE=${ROLLOUT_TP_SIZE:-1}
export GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.5}

MODEL=${MODEL:-$PAPER_ADAPTTHINK_1P5B}
TAG=${TAG:-adaptthink_1p5b_d005}

DATA_ROOT=${DATA_ROOT:-"$PWD/data"}
AIME_N=${AIME_N:-$PAPER_AIME_N}
MATH500_N=${MATH500_N:-$PAPER_MATH500_N}
GSM8K_N=${GSM8K_N:-$PAPER_GSM8K_N}

DUMMY_TRAIN="$DATA_ROOT/gsm8k/train.parquet"
paper_require_file "$DUMMY_TRAIN"
paper_require_file "$DATA_ROOT/aime2024/dev.parquet"
paper_require_file "$DATA_ROOT/aime2025/dev.parquet"
paper_require_file "$DATA_ROOT/math_lighteval/dev.parquet"
paper_require_file "$DATA_ROOT/gsm8k/dev.parquet"

echo "HF no-routing eval: MODEL=$MODEL TAG=$TAG TP=$ROLLOUT_TP_SIZE util=$GPU_MEM_UTIL"
echo "protocol: temp=$PAPER_VAL_TEMPERATURE top_p=$PAPER_VAL_TOP_P max_resp=$PAPER_MAX_RESPONSE_LENGTH"
echo "n: AIME=$AIME_N MATH500=$MATH500_N GSM8K=$GSM8K_N"

run_eval () {
    local BENCH="$1" VAL_FILES="$2" N="$3"
    local LOG="eval_bench_${BENCH}_${TAG}.log"
    local EXP="eval_hf_${TAG}_${BENCH}"
    echo ">>> $BENCH : val_files=$VAL_FILES  n=$N  -> $LOG"
    python3 -m verl.trainer.main_ppo \
        data.train_files="$DUMMY_TRAIN" \
        "data.val_files=$VAL_FILES" \
        data.train_batch_size=256 \
        data.val_batch_size=$PAPER_VAL_ONLY_BATCH_SIZE \
        data.dataloader_num_workers=2 \
        data.max_prompt_length=$PAPER_MAX_PROMPT_LENGTH \
        data.max_response_length=$PAPER_MAX_RESPONSE_LENGTH \
        actor_rollout_ref.model.path="$MODEL" \
        actor_rollout_ref.model.use_remove_padding=True \
        +actor_rollout_ref.model.override_config.attn_implementation=sdpa \
        actor_rollout_ref.actor.use_dynamic_bsz=True \
        actor_rollout_ref.actor.optim.lr=$PAPER_ACTOR_LR \
        actor_rollout_ref.actor.ppo_mini_batch_size=$PAPER_PPO_MINI_BATCH_SIZE \
        actor_rollout_ref.actor.ppo_micro_batch_size=$PAPER_PPO_MICRO_BATCH_SIZE \
        actor_rollout_ref.actor.loss_agg_mode=$PAPER_LOSS_AGG_MODE \
        actor_rollout_ref.actor.policy_loss.loss_mode=vanilla \
        actor_rollout_ref.actor.ppo_max_token_len_per_gpu=20480 \
        actor_rollout_ref.rollout.n=4 \
        actor_rollout_ref.rollout.prompt_length=$PAPER_MAX_PROMPT_LENGTH \
        actor_rollout_ref.rollout.tensor_model_parallel_size=$ROLLOUT_TP_SIZE \
        actor_rollout_ref.rollout.name=vllm \
        actor_rollout_ref.rollout.gpu_memory_utilization=$GPU_MEM_UTIL \
        actor_rollout_ref.rollout.log_prob_micro_batch_size=32 \
        actor_rollout_ref.rollout.val_kwargs.temperature=$PAPER_VAL_TEMPERATURE \
        actor_rollout_ref.rollout.val_kwargs.top_p=$PAPER_VAL_TOP_P \
        actor_rollout_ref.rollout.val_kwargs.do_sample=$PAPER_VAL_DO_SAMPLE \
        actor_rollout_ref.rollout.val_kwargs.n=$N \
        actor_rollout_ref.ref.log_prob_micro_batch_size=8 \
        critic.enable=False \
        algorithm.adv_estimator=grpo \
        algorithm.norm_adv_by_std_in_grpo=False \
        algorithm.use_kl_in_reward=False \
        algorithm.three_mode_routing.enable=False \
        trainer.n_gpus_per_node=$N_GPUS \
        trainer.nnodes=1 \
        trainer.resume_mode=disable \
        trainer.total_training_steps=0 \
        trainer.val_only=True \
        trainer.val_before_train=True \
        trainer.test_freq=1 \
        trainer.save_freq=999999 \
        trainer.logger=['console','wandb'] \
        trainer.project_name=three-mode-routing \
        trainer.experiment_name=$EXP \
        trainer.default_local_dir=$EXP \
        2>&1 | tee "$LOG"
    local rc=${PIPESTATUS[0]}
    if [ "$rc" -ne 0 ]; then
        echo "!!! $BENCH eval FAILED (exit $rc) — see $LOG"
    else
        echo "<<< $BENCH eval OK"
    fi
}

run_eval "aime" \
    "[$DATA_ROOT/aime2024/dev.parquet,$DATA_ROOT/aime2025/dev.parquet]" \
    "$AIME_N"

run_eval "math500" \
    "$DATA_ROOT/math_lighteval/dev.parquet" \
    "$MATH500_N"

run_eval "gsm8k" \
    "$DATA_ROOT/gsm8k/dev.parquet" \
    "$GSM8K_N"

echo ""
echo "=== SUMMARY (acc per benchmark, tag=$TAG) ==="
grep -hoP "val-core/[^ ]*acc/mean@\d+:[0-9.]+" \
    eval_bench_aime_${TAG}.log \
    eval_bench_math500_${TAG}.log \
    eval_bench_gsm8k_${TAG}.log 2>/dev/null | sort -u
echo "=== SUMMARY (mean response length) ==="
grep -hE "val-aux/response_length/mean:|val-lengths/response/mean:" \
    eval_bench_aime_${TAG}.log \
    eval_bench_math500_${TAG}.log \
    eval_bench_gsm8k_${TAG}.log 2>/dev/null
