#!/bin/bash
# Adaptive three-mode self-routing GRPO (NOTHINK / SHORT / LONG) on Big-Math-RL-Verified.
# v3 (2026-06-12): v2 (run 23729946) froze at unknown_fraction=1.0 — excluding unknowns
# from the group mean from step 1 removed the aggregate positive advantage on the forced
# routing tokens, which is the engine that bootstraps routing-word emission.  v3 gates
# the exclusion to start at step 30 (exclude_unknown_from_mean_start_step=30): bootstrap
# runs with the original dynamics, the clean mean takes over once unknowns are rare.
# Also fixed: caps now allow for the routing token (cap measures L after it), so forced
# rollouts that use their full budget are no longer flagged/clipped.
#
# Reward surface (keep this header in sync with the Hydra overrides!):
#   - NOTHINK -> base 1.4, gamma_nothink=0.999845 (NT/SH crossover ~1060 tok ~= 1024 cap), wrong -0.3
#   - SHORT   -> base 1.3, gamma_short=0.999915   (SH/LG crossover ~3090 tok ~= 3000 cap), wrong -0.1
#   - LONG    -> base 1.0, gamma_long=1.0 (no discount)
#   - unknown -> reward penalty -1.0 (since the group-mean fix it only suppresses the
#                unknown rollout itself, so the old -2 escalation is unnecessary)
#
# Rollout protocol (G = n_rollouts = 8, train_batch_size 128 -> 1024 rollouts/step,
# same step cost as the old 256 x 4):
#   phase 1 (steps 1..25):    2 forced per mode + 2 free
#   phase 2 (steps 26..end):  1 forced per mode + 5 free
#     warmup2_steps=10000 keeps this forced floor for the whole run: uniform-mode groups
#     give zero cross-mode gradient under mean-centering, so the floor preserves the
#     router's ability to recover from miscalibration.  Set warmup2_steps=50 to
#     reproduce the all-free math recipe instead.
#
# Two-pass free generation (two_pass_enable=True): pass 1 reads the routing word
# (8 tokens), pass 2 continues with the routed mode's exact remaining budget.  Caps
# become real generation stops (no discarded tokens), and unknown-routed rollouts stop
# after pass 1 (unknown_early_stop) — their reward is a constant penalty regardless of
# content, so the penalty gradient lands on the routing decision, not a reasoning trace.
#
# Balance term: coef 0.6 toward 1/3 (free rollouts only since the fix), annealed
# linearly to 0 over steps 40->60 (= end of training) — watch
# three_mode_routing/balance_coef_effective, routing_entropy and the mode fractions
# as the push decays.
#
# Per-mode caps 1024 / 3000 / 16384.  LONG cap == max_response_length so no tokens are
# generated beyond a binding cap.

#SBATCH --job-name=tmr_three_mode_routing_bigmath
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=64
#SBATCH --mem=600G
#SBATCH --time=06:00:00

module purge
module load 2025
module load CUDA/12.8.0

source ~/.bashrc
conda activate zero

# Ensure ROCm vars do not conflict with CUDA
unset ROCR_VISIBLE_DEVICES
unset HIP_VISIBLE_DEVICES

export HF_HOME=/scratch-shared/$USER/huggingface
mkdir -p $HF_HOME
export WANDB__SERVICE_WAIT=300
export WANDB_DIR=/scratch-shared/$USER/wandb
mkdir -p $WANDB_DIR

cd "${REPO_DIR:-$HOME/three-mode-routing}"

export N_GPUS=4
export ROLLOUT_TP_SIZE=1
export BASE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B

# Big-Math-RL-Verified dataset (generated by scripts/prepare_bigmath_math500.sh)
export DATA_DIR=${DATA_DIR:-"$PWD/data/bigmath"}
export TRAIN_FILE="$DATA_DIR/train.parquet"
export VAL_FILE="$DATA_DIR/dev.parquet"

export EXPERIMENT_NAME=32ktest_prompt_included

python3 -m verl.trainer.main_ppo \
    data.train_files=$TRAIN_FILE \
    data.val_files=$VAL_FILE \
    data.train_batch_size=128 \
    data.val_batch_size=256 \
    data.dataloader_num_workers=2 \
    data.max_prompt_length=2048 \
    data.max_response_length=32764 \
    data.filter_overlong_prompts=True \
    actor_rollout_ref.model.path=$BASE_MODEL \
    actor_rollout_ref.model.use_remove_padding=True \
    actor_rollout_ref.actor.use_dynamic_bsz=True \
    actor_rollout_ref.actor.optim.lr=1e-6 \
    actor_rollout_ref.actor.ppo_mini_batch_size=32 \
    actor_rollout_ref.actor.ppo_micro_batch_size=8 \
    actor_rollout_ref.actor.loss_agg_mode=token-mean \
    actor_rollout_ref.actor.policy_loss.loss_mode=vanilla \
    actor_rollout_ref.actor.ppo_max_token_len_per_gpu=32764 \
    actor_rollout_ref.rollout.n=8 \
    actor_rollout_ref.rollout.prompt_length=2048 \
    actor_rollout_ref.rollout.tensor_model_parallel_size=$ROLLOUT_TP_SIZE \
    actor_rollout_ref.rollout.name=vllm \
    actor_rollout_ref.rollout.gpu_memory_utilization=0.5 \
    actor_rollout_ref.rollout.log_prob_micro_batch_size=32 \
    actor_rollout_ref.rollout.val_kwargs.temperature=0.6 \
    actor_rollout_ref.rollout.val_kwargs.do_sample=True \
    actor_rollout_ref.rollout.val_kwargs.n=1 \
    actor_rollout_ref.ref.log_prob_micro_batch_size=8 \
    critic.enable=False \
    algorithm.adv_estimator=three_mode_routing \
    algorithm.gamma=1.0 \
    algorithm.norm_adv_by_std_in_grpo=False \
    algorithm.use_kl_in_reward=False \
    algorithm.kl_ctrl.kl_coef=0.001 \
    algorithm.three_mode_routing.enable=True \
    algorithm.three_mode_routing.nothink_token=NOTHINK \
    algorithm.three_mode_routing.short_token=SHORT \
    algorithm.three_mode_routing.long_token=LONG \
    algorithm.three_mode_routing.nothink_base=1.4 \
    algorithm.three_mode_routing.short_base=1.3 \
    algorithm.three_mode_routing.long_base=1.0 \
    algorithm.three_mode_routing.nothink_wrong_penalty=-0.3 \
    algorithm.three_mode_routing.short_wrong_penalty=-0.1 \
    algorithm.three_mode_routing.long_wrong_penalty=0.0 \
    algorithm.three_mode_routing.gamma_nothink=0.999845 \
    algorithm.three_mode_routing.gamma_short=0.999915 \
    algorithm.three_mode_routing.gamma_long=1.0 \
    algorithm.three_mode_routing.unknown_penalty=-1.0 \
    algorithm.three_mode_routing.exclude_unknown_from_mean_start_step=30 \
    algorithm.three_mode_routing.warmup_steps=25 \
    algorithm.three_mode_routing.warmup2_steps=10000 \
    algorithm.three_mode_routing.n_rollouts=8 \
    algorithm.three_mode_routing.nothink_max_tokens=1024 \
    algorithm.three_mode_routing.short_max_tokens=3000 \
    algorithm.three_mode_routing.long_max_tokens=16384 \
    algorithm.three_mode_routing.balance_coef=0.5 \
    "algorithm.three_mode_routing.balance_target=0.3333" \
    algorithm.three_mode_routing.balance_anneal_start_step=35 \
    algorithm.three_mode_routing.balance_anneal_end_step=60 \
    algorithm.three_mode_routing.balance_anneal_final_coef=0.0 \
    algorithm.three_mode_routing.two_pass_enable=True \
    algorithm.three_mode_routing.router_pass_tokens=8 \
    algorithm.three_mode_routing.unknown_early_stop=True \
    trainer.n_gpus_per_node=$N_GPUS \
    trainer.nnodes=1 \
    trainer.resume_mode=auto \
    trainer.total_training_steps=50 \
    trainer.save_freq=25 \
    trainer.test_freq=15 \
    trainer.val_before_train=True \
    trainer.val_only=True \
    trainer.logger=['console','wandb'] \
    trainer.project_name=three-mode-routing \
    trainer.experiment_name=$EXPERIMENT_NAME \
    trainer.default_local_dir=$EXPERIMENT_NAME \
    2>&1 | tee "three_mode_routing_bigmath_v3.log"
