#!/bin/bash
# ONE-SEED 7B scale check: same three-mode recipe as
# scripts/train_three_mode_routing_math.job, only the base model and GPU layout
# change. Goal: three modes still emerge and still sort by difficulty.
#
# Base: deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# Seed: 2 (avoid 1; it collides with verl's default actor.data_loader_seed)
#
# Algorithm / reward / caps / warmup / two-phase schedule: identical to the 1.5B
# paper run. Do not retune caps unless this run shows traces far from the 800 / 3000
# crossovers.
#
# GPU layout vs 1.5B (4×H100, same node):
#   rollout TP = 2, gpu_memory_utilization=0.4
# If the job OOMs, rerun with N_GPUS=8 on a larger allocation (keep every other
# Hydra override unchanged).
#
# Success metrics (W&B, step 90):
#   three_mode_routing/{nothink,short,long}_fraction all > 0
#   routing_entropy not collapsed (~> 0.5)
#   per-mode acc: NOTHINK/SHORT > LONG, or val-difficulties/level{1..5} monotone
#
# Checkpoints: /scratch-shared/$USER/three_mode_routing_ckpts/$EXPERIMENT_NAME
# Logs: ${EXPERIMENT_NAME}_phase{1,2}.log

#SBATCH --job-name=tmr_three_mode_routing_math_7b
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=64
#SBATCH --mem=600G
#SBATCH --time=16:00:00

module purge
module load 2025
module load CUDA/12.8.0

source ~/.bashrc
conda activate zero

set -euo pipefail

unset ROCR_VISIBLE_DEVICES
unset HIP_VISIBLE_DEVICES

export HF_HOME=/scratch-shared/$USER/huggingface
mkdir -p "$HF_HOME"
export WANDB__SERVICE_WAIT=300
export WANDB_DIR=/scratch-shared/$USER/wandb
mkdir -p "$WANDB_DIR"

cd "${REPO_DIR:-$HOME/three-mode-routing}"
# shellcheck source=scripts/paper_protocol.sh
source "${REPO_DIR:-$PWD}/scripts/paper_protocol.sh"

export N_GPUS=${N_GPUS:-4}
export ROLLOUT_TP_SIZE=${ROLLOUT_TP_SIZE:-2}
export GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.4}
export BASE_MODEL=${BASE_MODEL:-$PAPER_BASE_MODEL_7B}
export SEED=${SEED:-2}

export DATA_DIR=${DATA_DIR:-"$PWD/data/math_lighteval"}
export TRAIN_FILE="$DATA_DIR/train.parquet"
export VAL_FILE="$DATA_DIR/dev.parquet"
paper_require_file "$TRAIN_FILE"
paper_require_file "$VAL_FILE"

export EXPERIMENT_NAME=${EXPERIMENT_NAME:-three_mode_routing_math_7b_seed${SEED}}
export CKPT_DIR=/scratch-shared/$USER/three_mode_routing_ckpts/$EXPERIMENT_NAME
mkdir -p "$CKPT_DIR"

if [[ "$SEED" == "1" ]]; then
    echo "ERROR: seed 1 collides with verl's default actor.data_loader_seed. Use SEED=2." >&2
    exit 1
fi

echo "[$EXPERIMENT_NAME] 7B one-seed | model=$BASE_MODEL seed=$SEED TP=$ROLLOUT_TP_SIZE util=$GPU_MEM_UTIL"

BASE_ARGS=(
    "data.train_files=$TRAIN_FILE"
    "data.val_files=$VAL_FILE"
    "data.train_batch_size=$PAPER_TRAIN_BATCH_SIZE"
    "data.val_batch_size=$PAPER_VAL_BATCH_SIZE"
    "data.dataloader_num_workers=2"
    "data.max_prompt_length=$PAPER_MAX_PROMPT_LENGTH"
    "data.max_response_length=$PAPER_MAX_RESPONSE_LENGTH"
    "data.filter_overlong_prompts=True"
    "data.seed=$SEED"

    "actor_rollout_ref.model.path=$BASE_MODEL"
    "actor_rollout_ref.model.use_remove_padding=True"
    "actor_rollout_ref.actor.use_dynamic_bsz=True"
    "actor_rollout_ref.actor.optim.lr=$PAPER_ACTOR_LR"
    "actor_rollout_ref.actor.ppo_mini_batch_size=$PAPER_PPO_MINI_BATCH_SIZE"
    "actor_rollout_ref.actor.ppo_micro_batch_size=$PAPER_PPO_MICRO_BATCH_SIZE"
    "actor_rollout_ref.actor.loss_agg_mode=$PAPER_LOSS_AGG_MODE"
    "actor_rollout_ref.actor.policy_loss.loss_mode=vanilla"
    "actor_rollout_ref.actor.ppo_max_token_len_per_gpu=20480"
    "actor_rollout_ref.actor.data_loader_seed=$SEED"
    "actor_rollout_ref.actor.fsdp_config.seed=$SEED"
    "actor_rollout_ref.rollout.n=$PAPER_GROUP_SIZE"
    "actor_rollout_ref.rollout.prompt_length=$PAPER_MAX_PROMPT_LENGTH"
    "actor_rollout_ref.rollout.tensor_model_parallel_size=$ROLLOUT_TP_SIZE"
    "actor_rollout_ref.rollout.name=vllm"
    "actor_rollout_ref.rollout.gpu_memory_utilization=$GPU_MEM_UTIL"
    "actor_rollout_ref.rollout.log_prob_micro_batch_size=32"
    "actor_rollout_ref.rollout.val_kwargs.temperature=$PAPER_VAL_TEMPERATURE"
    "actor_rollout_ref.rollout.val_kwargs.top_p=$PAPER_VAL_TOP_P"
    "actor_rollout_ref.rollout.val_kwargs.do_sample=$PAPER_VAL_DO_SAMPLE"
    "actor_rollout_ref.rollout.val_kwargs.n=1"
    "actor_rollout_ref.ref.log_prob_micro_batch_size=8"
    "actor_rollout_ref.ref.fsdp_config.seed=$SEED"

    "critic.enable=False"

    "algorithm.adv_estimator=three_mode_routing"
    "algorithm.gamma=1.0"
    "algorithm.norm_adv_by_std_in_grpo=False"
    "algorithm.use_kl_in_reward=False"
    "algorithm.kl_ctrl.kl_coef=0.001"
    "algorithm.three_mode_routing.enable=True"
    "algorithm.three_mode_routing.nothink_token=NOTHINK"
    "algorithm.three_mode_routing.short_token=SHORT"
    "algorithm.three_mode_routing.long_token=LONG"
    "algorithm.three_mode_routing.nothink_wrong_penalty=0.0"
    "algorithm.three_mode_routing.short_wrong_penalty=0.0"
    "algorithm.three_mode_routing.long_wrong_penalty=0.0"
    "algorithm.three_mode_routing.unknown_penalty=$PAPER_UNKNOWN_PENALTY"
    "algorithm.three_mode_routing.exclude_unknown_from_mean=False"
    "algorithm.three_mode_routing.warmup_steps=$PAPER_WARMUP_STEPS"
    "algorithm.three_mode_routing.warmup2_steps=0"
    "algorithm.three_mode_routing.n_rollouts=$PAPER_GROUP_SIZE"
    "algorithm.three_mode_routing.nothink_max_tokens=$PAPER_NOTHINK_CAP"
    "algorithm.three_mode_routing.short_max_tokens=$PAPER_SHORT_CAP"
    "algorithm.three_mode_routing.long_max_tokens=$PAPER_LONG_CAP"
    "algorithm.three_mode_routing.balance_coef=$PAPER_BALANCE_COEF"
    "algorithm.three_mode_routing.balance_target=$PAPER_BALANCE_TARGET"
    "algorithm.three_mode_routing.balance_correctness_gated=True"
    "algorithm.three_mode_routing.balance_protect_long_incorrect=True"
    "algorithm.three_mode_routing.two_pass_enable=False"

    "trainer.n_gpus_per_node=$N_GPUS"
    "trainer.nnodes=1"
    "trainer.val_before_train=True"
    "trainer.val_only=False"
    'trainer.logger=["console","wandb"]'
    "trainer.project_name=three-mode-routing"
    "trainer.experiment_name=$EXPERIMENT_NAME"
    "trainer.default_local_dir=$CKPT_DIR"
)

PHASE1_ARGS=(
    "${BASE_ARGS[@]}"
    "algorithm.three_mode_routing.nothink_base=$PAPER_NOTHINK_BASE"
    "algorithm.three_mode_routing.short_base=$PAPER_SHORT_BASE"
    "algorithm.three_mode_routing.long_base=$PAPER_LONG_BASE"
    "algorithm.three_mode_routing.gamma_nothink=$PAPER_GAMMA_NOTHINK"
    "algorithm.three_mode_routing.gamma_short=$PAPER_GAMMA_SHORT"
    "algorithm.three_mode_routing.gamma_long=$PAPER_GAMMA_LONG"
    "algorithm.three_mode_routing.balance_anneal_start_step=$PAPER_PHASE1_STEPS"
    "algorithm.three_mode_routing.balance_anneal_end_step=$PAPER_BALANCE_ANNEAL_END_STEP"
    "algorithm.three_mode_routing.balance_anneal_final_coef=0.0"
    "trainer.resume_mode=auto"
    "trainer.total_training_steps=$PAPER_PHASE1_STEPS"
    "trainer.save_freq=$PAPER_PHASE1_STEPS"
    "trainer.test_freq=$PAPER_TEST_FREQ"
)

RESUME_CKPT="$CKPT_DIR/global_step_${PAPER_PHASE1_STEPS}"

PHASE2_ARGS=(
    "${BASE_ARGS[@]}"
    "algorithm.three_mode_routing.nothink_base=1.0"
    "algorithm.three_mode_routing.short_base=1.0"
    "algorithm.three_mode_routing.long_base=1.0"
    "algorithm.three_mode_routing.gamma_nothink=1.0"
    "algorithm.three_mode_routing.gamma_short=1.0"
    "algorithm.three_mode_routing.gamma_long=1.0"
    "algorithm.three_mode_routing.balance_anneal_start_step=$PAPER_TOTAL_STEPS"
    "algorithm.three_mode_routing.balance_anneal_end_step=$PAPER_TOTAL_STEPS"
    "algorithm.three_mode_routing.balance_anneal_final_coef=0.0"
    "trainer.resume_mode=resume_path"
    "trainer.resume_from_path=$RESUME_CKPT"
    "trainer.total_training_steps=$PAPER_TOTAL_STEPS"
    "trainer.save_freq=15"
    "trainer.test_freq=$PAPER_TEST_FREQ"
)

echo "[$EXPERIMENT_NAME] phase 1/2: steps 0 -> $PAPER_PHASE1_STEPS, shaped bases/gammas"
python3 -m verl.trainer.main_ppo \
    "${PHASE1_ARGS[@]}" \
    2>&1 | tee "${EXPERIMENT_NAME}_phase1.log"

if [ ! -d "$RESUME_CKPT/actor" ]; then
    echo "ERROR: expected checkpoint $RESUME_CKPT/actor after phase 1, not found" >&2
    exit 1
fi

echo "[$EXPERIMENT_NAME] phase 2/2: steps $PAPER_PHASE1_STEPS -> $PAPER_TOTAL_STEPS, flat bases/gammas"
python3 -m verl.trainer.main_ppo \
    "${PHASE2_ARGS[@]}" \
    2>&1 | tee "${EXPERIMENT_NAME}_phase2.log"
