#!/bin/bash
# ABLATION: fully-forced single-mode training on MATH-lighteval.
#
# Every rollout, every step, for the WHOLE run is forced into ONE routing mode
# (NOTHINK / SHORT / LONG) via algorithm.three_mode_routing.train_forced_mode.
# There is no free/self-routing behaviour at all: n_forced=n_rollouts, n_free=0
# for the entire run (not just a warmup phase). This isolates "how well does
# GRPO train under mode X's token cap alone", with no routing/balance dynamics
# confounding the result — a clean per-mode floor/ceiling to compare against the
# adaptive three-mode router (train_three_mode_routing_math.job, the
# 0.792-family run whose reward surface/hparams this script mirrors exactly).
#
# Validation is ALSO forced into the same mode (val_forced_mode) so val curves
# report pure per-mode accuracy/length: the model was never trained to emit the
# routing token itself (it's always prefilled), so free validation would just
# measure whether it copies a token it never had to choose.
#
# Everything below matches train_three_mode_routing_math.job's reward-surface
# hyperparameters (batch_size=128, bases 1.3/1.2/1.0, gamma_nothink=0.99984,
# gamma_short=0.99994, balance_* flags) so results are directly comparable to
# that run — the intentional differences are:
#   - train_forced_mode / val_forced_mode / enabled_modes (this is what makes it
#     a forced single-mode ablation instead of adaptive routing)
#   - rollout.n / n_rollouts = 4 (not 8) and a single 45-step phase (not 90):
#     fresh start from the base model, resume_mode=disable so a re-submitted
#     job always starts over rather than continuing a stale checkpoint dir —
#     the ablation asks "what if trained in this one mode from step 0 for the
#     warmup-length window", not "continue an already-routed checkpoint"
# balance_coef/balance_target/balance_correctness_gated/balance_protect_long_incorrect
# are kept at the balgated values even though they are no-ops here (balance_free_only
# excludes forced rollouts from the balance fraction, and every rollout is forced).
#
# Usage (override via env vars, MODE required in {NOTHINK,SHORT,LONG}):
#   MODE=NOTHINK sbatch scripts/train_forced_single_mode_math.job
#   MODE=SHORT   sbatch scripts/train_forced_single_mode_math.job
#   MODE=LONG    sbatch scripts/train_forced_single_mode_math.job
#
# Checkpoints: /scratch-shared/$USER/three_mode_routing_ckpts/forced_<mode>_math (home quota is tight)
# Logs/experiment name: forced_<mode>_math{.log, /}

#SBATCH --job-name=tmr_forced_single_mode
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=64
#SBATCH --mem=600G
#SBATCH --time=08:00:00

module purge
module load 2025
module load CUDA/12.8.0

source ~/.bashrc
conda activate zero

unset ROCR_VISIBLE_DEVICES
unset HIP_VISIBLE_DEVICES

export HF_HOME=/scratch-shared/$USER/huggingface
mkdir -p $HF_HOME
export WANDB__SERVICE_WAIT=300
export WANDB_DIR=/scratch-shared/$USER/wandb
mkdir -p $WANDB_DIR

cd "${REPO_DIR:-$HOME/three-mode-routing}"

export N_GPUS=4
export ROLLOUT_TP_SIZE=1
export BASE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B

export DATA_DIR=${DATA_DIR:-"$PWD/data/math_lighteval"}
export TRAIN_FILE="$DATA_DIR/train.parquet"
export VAL_FILE="$DATA_DIR/dev.parquet"

# Mode to force for the ENTIRE run (train + val). Required: NOTHINK | SHORT | LONG.
MODE="${1:-${MODE:-}}"
case "${MODE^^}" in
    NOTHINK|SHORT|LONG) ;;
    *)
        echo "ERROR: MODE must be NOTHINK, SHORT, or LONG (got '$MODE')." >&2
        echo "Usage: MODE=NOTHINK sbatch scripts/train_forced_single_mode_math.job" >&2
        exit 1
        ;;
esac
MODE_LC="${MODE,,}"

export EXPERIMENT_NAME="forced_${MODE_LC}_math"

# New checkpoints go to scratch (home quota is tight) — same convention as balgated.
export CKPT_DIR=/scratch-shared/$USER/three_mode_routing_ckpts/$EXPERIMENT_NAME
mkdir -p "$CKPT_DIR"

echo "Forced mode: $MODE | experiment: $EXPERIMENT_NAME | ckpt: $CKPT_DIR"

python3 -m verl.trainer.main_ppo \
    data.train_files=$TRAIN_FILE \
    data.val_files=$VAL_FILE \
    data.train_batch_size=128 \
    data.val_batch_size=256 \
    data.dataloader_num_workers=2 \
    data.max_prompt_length=2048 \
    data.max_response_length=16384 \
    data.filter_overlong_prompts=True \
    actor_rollout_ref.model.path=$BASE_MODEL \
    actor_rollout_ref.model.use_remove_padding=True \
    actor_rollout_ref.actor.use_dynamic_bsz=True \
    actor_rollout_ref.actor.optim.lr=1e-6 \
    actor_rollout_ref.actor.ppo_mini_batch_size=32 \
    actor_rollout_ref.actor.ppo_micro_batch_size=8 \
    actor_rollout_ref.actor.loss_agg_mode=token-mean \
    actor_rollout_ref.actor.policy_loss.loss_mode=vanilla \
    actor_rollout_ref.actor.ppo_max_token_len_per_gpu=20480 \
    actor_rollout_ref.rollout.n=4 \
    actor_rollout_ref.rollout.prompt_length=2048 \
    actor_rollout_ref.rollout.tensor_model_parallel_size=$ROLLOUT_TP_SIZE \
    actor_rollout_ref.rollout.name=vllm \
    actor_rollout_ref.rollout.gpu_memory_utilization=0.5 \
    actor_rollout_ref.rollout.log_prob_micro_batch_size=32 \
    actor_rollout_ref.rollout.val_kwargs.temperature=0.6 \
    actor_rollout_ref.rollout.val_kwargs.do_sample=True \
    actor_rollout_ref.rollout.val_kwargs.n=1 \
    actor_rollout_ref.ref.log_prob_micro_batch_size=8 \
    critic.enable=False \
    algorithm.adv_estimator=three_mode_routing \
    algorithm.gamma=1.0 \
    algorithm.norm_adv_by_std_in_grpo=False \
    algorithm.use_kl_in_reward=False \
    algorithm.kl_ctrl.kl_coef=0.001 \
    algorithm.three_mode_routing.enable=True \
    "algorithm.three_mode_routing.enabled_modes=${MODE_LC}" \
    algorithm.three_mode_routing.nothink_token=NOTHINK \
    algorithm.three_mode_routing.short_token=SHORT \
    algorithm.three_mode_routing.long_token=LONG \
    algorithm.three_mode_routing.nothink_base=1.3 \
    algorithm.three_mode_routing.short_base=1.2 \
    algorithm.three_mode_routing.long_base=1.0 \
    algorithm.three_mode_routing.nothink_wrong_penalty=0.0 \
    algorithm.three_mode_routing.short_wrong_penalty=0.0 \
    algorithm.three_mode_routing.long_wrong_penalty=0.0 \
    algorithm.three_mode_routing.gamma_nothink=0.99984 \
    algorithm.three_mode_routing.gamma_short=0.99994 \
    algorithm.three_mode_routing.gamma_long=1.0 \
    algorithm.three_mode_routing.reasoning_only=False \
    algorithm.three_mode_routing.unknown_penalty=-0.5 \
    algorithm.three_mode_routing.exclude_unknown_from_mean=False \
    algorithm.three_mode_routing.warmup_steps=45 \
    algorithm.three_mode_routing.warmup2_steps=0 \
    algorithm.three_mode_routing.n_rollouts=4 \
    algorithm.three_mode_routing.nothink_max_tokens=1024 \
    algorithm.three_mode_routing.short_max_tokens=3000 \
    algorithm.three_mode_routing.long_max_tokens=16384 \
    algorithm.three_mode_routing.balance_coef=1.0 \
    "algorithm.three_mode_routing.balance_target=0.3333" \
    algorithm.three_mode_routing.balance_correctness_gated=True \
    algorithm.three_mode_routing.balance_protect_long_incorrect=True \
    algorithm.three_mode_routing.two_pass_enable=False \
    algorithm.three_mode_routing.balance_anneal_start_step=90 \
    algorithm.three_mode_routing.balance_anneal_end_step=90 \
    algorithm.three_mode_routing.balance_anneal_final_coef=0.0 \
    "algorithm.three_mode_routing.train_forced_mode=${MODE_LC}" \
    "algorithm.three_mode_routing.val_forced_mode=${MODE_LC}" \
    trainer.n_gpus_per_node=$N_GPUS \
    trainer.nnodes=1 \
    trainer.resume_mode=disable \
    trainer.total_training_steps=45 \
    trainer.save_freq=45 \
    trainer.test_freq=15 \
    trainer.val_before_train=True \
    trainer.val_only=False \
    trainer.logger=['console','wandb'] \
    trainer.project_name=three-mode-routing \
    trainer.experiment_name=$EXPERIMENT_NAME \
    trainer.default_local_dir=$CKPT_DIR \
    2>&1 | tee "${EXPERIMENT_NAME}.log"
